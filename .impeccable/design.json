  "narrative": {
    "northStar": "The Geospatial Workstation",
    "overview": "SARscape places the landscape at the center of the interface. Frost-white instruments, restrained deep teal actions, and compact ink labels frame genuine natural-color imagery. Familiar geospatial and shadcn-like controls keep choosing, comparing, and tracing captures understandable.\n\nThis is a code-led system recorded from the implemented frontend, without a separate visual comp. The visual finish review covered the desktop detail view and desktop/mobile change lens and returned a ship disposition. That review establishes interface finish only. No authentic GOFF granule has yet been processed in this project, and independent science validation remains outstanding.",
    "keyCharacteristics": [
      "A full-height map with a compact instrument sidebar and floating tools.",
      "Genuine dated imagery, fixed terrain, and visible provenance.",
      "Quiet neutral surfaces with teal reserved for actions and selected states.",
      "Comparison through a movable lens, swipe, or actual capture blink."
    ],
    "rules": [
      {
        "name": "The Instrument Accent Rule",
        "body": "Use teal to identify an action or state; genuine imagery supplies the map's visual richness.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Keep dates, coordinates, and measured values in tabular numerals where implemented, so changes remain easy to compare.",
        "section": "typography"
      },
      {
        "name": "The Data Depth Rule",
        "body": "UI shadows express tool layering; terrain relief never implies a measured elevation change.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give the map the largest continuous region and keep its controls familiar.",
      "**Do** keep source dates, real-image identity, loading state, and provenance visible.",
      "**Do** maintain keyboard focus and keyboard operation for comparison controls.",
      "**Do** preserve original scientific measurements and label display previews as derived products.",
      "**Do** state that terrain is fixed and independent science validation is outstanding."
    ],
    "donts": [
      "**Don't** add synthetic motion cells, generated in-between captures, or animated terrain change.",
      "**Don't** present optical appearance comparisons as measured velocity or elevation change.",
      "**Don't** treat successful interface review or fixture tests as validation of glacier science.",
      "**Don't** replace the established workstation controls with ornamental or unfamiliar interaction patterns."
    ]
  }
}
